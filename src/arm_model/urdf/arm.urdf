<?xml version="1.0"?>
<robot name="intern_arm">

  <material name="gray">
    <color rgba="0.5 0.5 0.5 1"/>
  </material>
  <material name="blue">
    <color rgba="0.2 0.5 0.8 1"/>
  </material>
  <material name="orange">
    <color rgba="0.9 0.5 0.1 1"/>
  </material>
  <material name="dark_gray">
    <color rgba="0.2 0.2 0.2 1"/>
  </material>

  <!-- Base Link (Tinggi 0.1 m) -->
  <link name="base_link">
    <visual>
      <geometry>
        <cylinder length="0.1" radius="0.08"/>
      </geometry>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <material name="gray"/>
    </visual>
  </link>

  <!-- JOINT 1 (DoF 1): Rotasi sumbu Z di atas base_link (z = 0.1) -->
  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_2"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10.0" velocity="1.0"/>
  </joint>

  <!-- Lengan bawah (Tinggi 0.25 m) -->
  <link name="link_2">
    <visual>
      <geometry>
        <box size="0.06 0.06 0.25"/>
      </geometry>
      <origin xyz="0 0 0.125" rpy="0 0 0"/>
      <material name="blue"/>
    </visual>
  </link>

  <!-- JOINT 2 (DoF 2): Rotasi sumbu Y di ujung atas link_2 (z = 0.25) -->
  <joint name="joint_2" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0 0 0.25" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="1.0"/>
  </joint>

  <!-- Lengan atas (Tinggi 0.20 m) -->
  <link name="link_3">
    <visual>
      <geometry>
        <box size="0.045 0.045 0.20"/>
      </geometry>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <material name="orange"/>
    </visual>
  </link>

  <!-- JOINT 3 (DoF 3): Rotasi sumbu Y di ujung atas link_3 (z = 0.20) -->
  <joint name="joint_3" type="revolute">
    <parent link="link_3"/>
    <child link="link_4"/>
    <origin xyz="0 0 0.20" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="1.0"/>
  </joint>

  <!-- LINK 4: Gripper / Pencapit (3 visual dalam 1 link) -->
  <link name="link_4">
    <!-- Telapak gripper (z: 0 sampai 0.025) -->
    <visual>
      <geometry>
        <box size="0.03 0.12 0.025"/>
      </geometry>
      <origin xyz="0 0 0.0125" rpy="0 0 0"/>
      <material name="dark_gray"/>
    </visual>

    <!-- Jari kiri (nempel di atas telapak, z: 0.025 sampai 0.115) -->
    <visual>
      <geometry>
        <box size="0.03 0.02 0.09"/>
      </geometry>
      <origin xyz="0 0.05 0.07" rpy="0 0 0"/>
      <material name="dark_gray"/>
    </visual>

    <!-- Jari kanan (nempel di atas telapak, z: 0.025 sampai 0.115) -->
    <visual>
      <geometry>
        <box size="0.03 0.02 0.09"/>
      </geometry>
      <origin xyz="0 -0.05 0.07" rpy="0 0 0"/>
      <material name="dark_gray"/>
    </visual>
  </link>

</robot>